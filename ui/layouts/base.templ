package layouts

import (
	"github.com/br-lemes/golem/ui/components/datatable"
	"github.com/br-lemes/golem/ui/components/loading"
	"github.com/br-lemes/golem/ui/components/navigation"
	"github.com/br-lemes/golem/ui/components/notifications"
	"github.com/br-lemes/golem/ui/components/routetrail"
	"github.com/br-lemes/golem/ui/routes"
)

type Props = routes.Route

templ Base(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ var currentPath string }}
	if p.Route != nil {
		{{ currentPath = p.Route.Path }}
	}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				content="initial-scale=1.0, width=device-width"
				name="viewport"
			/>
			<link
				href="/assets/images/head.png"
				rel="icon"
				type="image/png"
			/>
			<link href="/assets/golem.css" rel="stylesheet"/>
			@datatable.Styles()
			@navigation.Styles()
			<title>Golem</title>
		</head>
		<body>
			<script src="/assets/theme.js"></script>
			<div class="page">
				@navigation.Navigation(navigation.Props{
					Groups: true,
					Path:   currentPath,
				})
				<div class="page-wrapper">
					@loading.Bar()
					<main id="swr-content-wrapper" class="page-body position-relative">
						<div id="main-content" class="container-xl d-flex flex-column flex-fill">
							@routetrail.RouteTrail(p)
							{ children... }
						</div>
						@loading.Overlay()
					</main>
				</div>
			</div>
			@notifications.Notifications()
			<script src="/assets/golem.js"></script>
		</body>
	</html>
}
