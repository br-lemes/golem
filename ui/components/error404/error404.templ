package error404

import "github.com/br-lemes/golem/ui/layouts"

templ Error404() {
	@layouts.Base() {
		<div class="flex h-full items-center justify-center">
			<div class="max-w-[400px] w-[80vw]">
				<img
					alt="Golem 404 Logo"
					class="h-auto w-full"
					src="/assets/images/404.png"
				/>
				<h1 class="[font-variant-caps:small-caps] font-bold text-4xl text-center">
					Page Not Found
				</h1>
				<p class="text-3xl text-center">
					The requested page does not exist.
				</p>
			</div>
		</div>
	}
}
