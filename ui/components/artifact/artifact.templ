package artifact

import "fmt"

type Type string

const (
	TypeBadge      Type = "badges"
	TypeCharacters Type = "characters"
	TypeEffects    Type = "effects"
	TypeItems      Type = "items"
	TypeMaps       Type = "maps"
	TypeMonsters   Type = "monsters"
	TypeNPCs       Type = "npcs"
	TypeResources  Type = "resources"
)

type Props struct {
	Class string
	Code  string
	Name  string
	Size  string
	Type  Type
}

templ Image(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ src := fmt.Sprintf("https://artifactsmmo.com/images/%s/%s.png", p.Type, p.Code) }}
	<img
		alt={ p.Name }
		class={ "object-fit-contain", p.Class }
		if p.Size != "" {
			style={ fmt.Sprintf("width: %s; height: %s;", p.Size, p.Size) }
		}
		src={ src }
	/>
}

templ Label(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = "1rem" }}
	}
	<span class={ "align-items-center d-inline-flex gap-1", p.Class }>
		@Image(Props{Code: p.Code, Name: p.Name, Size: p.Size, Type: p.Type})
		{ p.Code }
	</span>
}
