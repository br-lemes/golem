package datatable

import (
	"encoding/json"
	"fmt"
)

templ dataTableHeader(state dataTableState) {
	{{ filterSummary := filterSummary(state.Query.Filters) }}
	<div class="card-header">
		<div class="align-items-center flex-fill g-2 row">
			<div class="col-md-4 d-flex justify-content-center justify-content-md-start">
				if state.Refresh == RefreshAuto {
					<div class="input-icon">
						<span class="input-icon-addon">
							<i aria-hidden="true" class="ti ti-refresh"></i>
						</span>
						<select
							aria-label="Auto refresh"
							class="form-select w-auto"
							data-swr-refresh={ state.Refresh }
						>
							for _, period := range RefreshPeriods {
								<option
									selected?={ period == state.RefreshPeriod }
									value={ period }
								>
									{ period }s
								</option>
							}
						</select>
					</div>
				} else if state.Refresh == RefreshManual {
					<a
						aria-label="Refresh"
						class="btn btn-icon btn-primary rounded-circle"
						data-swr="true"
						href={ queryHref(state.Path, state.Query, state.Query.Page) }
					>
						<i aria-hidden="true" class="ti ti-refresh"></i>
					</a>
				}
				if state.Filter != nil {
					<button
						aria-label="Filter"
						class="btn btn-icon btn-primary rounded-circle"
						data-filter-modal
						data-bs-target={ "#" + state.FilterModalID }
						data-bs-toggle="modal"
						type="button"
					>
						<i aria-hidden="true" class="ti ti-filter"></i>
					</button>
				}
			</div>
			<div class="col-md-4 text-center" data-swr-region="summary">
				<div aria-label={ recordsLabel(len(state.Rows), state.TotalItems) }>
					Records: { fmt.Sprint(len(state.Rows)) }
					if state.TotalItems != nil {
						{ " / " }
						{ fmt.Sprint(*state.TotalItems) }
					}
				</div>
				if filterSummary != "" {
					<div class="small text-secondary">
						<small class="font-monospace">
							{ filterSummary }
						</small>
					</div>
				}
			</div>
			<div class="col-md-4 d-flex justify-content-center justify-content-md-end">
				<form
					action={ queryHref(state.Path, state.Query, state.Query.Page) }
					data-swr-navigate
					method="get"
				>
					<div class="input-icon">
						<span class="input-icon-addon">
							<i aria-hidden="true" class="ti ti-search"></i>
						</span>
						<input
							aria-label="Search"
							class="form-control w-auto"
							name="search"
							placeholder="Search"
							type="search"
							value={ state.Query.Search }
						/>
					</div>
				</form>
			</div>
		</div>
	</div>
}

templ dataTableColumns(state dataTableState) {
	<tr>
		for _, column := range state.Columns {
			<th class="text-nowrap">
				if column.Sortable && state.Path != "" {
					<a
						class="text-decoration-none text-reset"
						data-swr="true"
						href={ queryHref(state.Path, sortQuery(state.Query, column.Field), 1) }
					>
						{ column.Header }
						if state.Query.Sort == column.Field && state.Query.Direction == "asc" {
							<i
								aria-label="Sorted ascending"
								class="text-primary ti ti-arrow-up"
							></i>
						} else if state.Query.Sort == column.Field && state.Query.Direction == "desc" {
							<i
								aria-label="Sorted descending"
								class="text-primary ti ti-arrow-down"
							></i>
						} else {
							<i
								aria-label="Not sorted"
								class="text-secondary ti ti-arrows-sort"
							></i>
						}
					</a>
				} else {
					{ column.Header }
				}
			</th>
		}
	</tr>
}

func sortQuery(query Query, field string) Query {
	query.Page = 1
	if query.Sort != field {
		query.Sort = field
		query.Direction = "asc"
	} else if query.Direction == "asc" {
		query.Direction = "desc"
	} else {
		query.Sort = ""
		query.Direction = ""
	}
	return query
}

func filterSummary(filters map[string]string) string {
	if len(filters) == 0 {
		return ""
	}
	value, err := json.Marshal(filters)
	if err != nil {
		return ""
	}
	return string(value)
}

func recordsLabel(rowCount int, totalItems *int) string {
	if totalItems == nil {
		return fmt.Sprintf("%d records", rowCount)
	}
	return fmt.Sprintf("%d of %d records", rowCount, *totalItems)
}
