package datatable

import (
	"encoding/json"
	"fmt"
	"net/url"
	"reflect"
	"strconv"
	"strings"
)

// Keep this value in sync with assets/src/datatable.ts.
const DefaultSize = 10

var Sizes = []int{5, 10, 25, 50, 100, 250, 500, 1000}

type Column[T any] struct {
	Cell     func(T) templ.Component
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type DataTableProps[T any] struct {
	Columns       []Column[T]
	Data          []T
	EmptyMessage  string
	Filter        templ.Component
	FilterModalID string
	Path          string
	Query         Query
	TotalItems    *int
	RowHref       func(T) string
}

type Query struct {
	Page      int
	Size      int
	Search    string
	Sort      string
	Direction string
	Filters   map[string]string
}

type dataTableColumn struct {
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type dataTableCell struct {
	Class     string
	Component templ.Component
	Text      string
}

func DataTable[T any](props DataTableProps[T]) templ.Component {
	if props.Query.Size == 0 {
		props.Query.Size = DefaultSize
	}
	value := reflect.ValueOf(props.Data)

	rows := make([][]dataTableCell, value.Len())
	rowHrefs := make([]string, value.Len())
	for rowIndex := 0; rowIndex < value.Len(); rowIndex++ {
		item := value.Index(rowIndex)
		rows[rowIndex] = make([]dataTableCell, len(props.Columns))
		for columnIndex, column := range props.Columns {
			cell := dataTableCell{Class: column.Class}
			if column.Cell != nil {
				cell.Component = column.Cell(item.Interface().(T))
			} else if column.Field != "" {
				cell.Text = tableFieldText(item, column.Field)
			}
			rows[rowIndex][columnIndex] = cell
		}
		if props.RowHref != nil {
			rowHrefs[rowIndex] = props.RowHref(item.Interface().(T))
		}
	}

	definitions := make([]dataTableColumn, len(props.Columns))
	for index, column := range props.Columns {
		definitions[index] = dataTableColumn{
			Header:   column.Header,
			Class:    column.Class,
			Field:    column.Field,
			Sortable: column.Sortable,
		}
	}
	return dataTable(rows, definitions, rowHrefs, props.EmptyMessage, props.Path, props.Query, props.TotalItems, props.Filter, props.FilterModalID)
}

func ValidSize(size int) int {
	for _, allowed := range Sizes {
		if size == allowed {
			return size
		}
	}
	return DefaultSize
}

templ Styles() {
	<style>
		.data-table {
			--tblr-table-striped-bg: color-mix(
				in oklab,
				var(--tblr-body-color) 3%,
				transparent
			);
			font-size: 1rem;
			line-height: 1.5;
		}

		.data-table > :not(caption) > * > * {
			padding: 0.5rem;
		}

		.data-table > thead > tr > th {
			background: var(--tblr-table-striped-bg);
			color: inherit;
			font-size: inherit;
			font-weight: bold;
			letter-spacing: normal;
			line-height: inherit;
			text-transform: none;
			white-space: normal;
		}
	</style>
}

func tableFieldText(item reflect.Value, fieldName string) string {
	for item.Kind() == reflect.Pointer {
		if item.IsNil() {
			return ""
		}
		item = item.Elem()
	}
	if item.Kind() != reflect.Struct {
		panic("data table items must contain structs")
	}

	typeOfItem := item.Type()
	for index := 0; index < item.NumField(); index++ {
		field := typeOfItem.Field(index)
		jsonName := strings.Split(field.Tag.Get("json"), ",")[0]
		if jsonName == fieldName {
			return fmt.Sprint(item.Field(index).Interface())
		}
	}
	panic(fmt.Sprintf("data table field %q not found in %s", fieldName, typeOfItem))
}

func queryHref(path string, query Query, page int) string {
	values := url.Values{}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	if query.Size != 0 && query.Size != DefaultSize {
		values.Set("size", strconv.Itoa(query.Size))
	}
	if query.Search != "" {
		values.Set("search", query.Search)
	}
	if query.Sort != "" && (query.Direction == "asc" || query.Direction == "desc") {
		values.Set("sort", query.Sort)
		values.Set("direction", query.Direction)
	}
	for key, value := range query.Filters {
		if value != "" {
			values.Set("filter["+key+"]", value)
		}
	}
	encoded := values.Encode()
	if encoded != "" {
		return path + "?" + encoded
	}
	return path
}

func sortQuery(query Query, field string) Query {
	query.Page = 1
	if query.Sort != field {
		query.Sort = field
		query.Direction = "asc"
	} else if query.Direction == "asc" {
		query.Direction = "desc"
	} else {
		query.Sort = ""
		query.Direction = ""
	}
	return query
}

func filterSummary(filters map[string]string) string {
	if len(filters) == 0 {
		return ""
	}
	value, err := json.Marshal(filters)
	if err != nil {
		return ""
	}
	return string(value)
}

func recordsLabel(rowCount int, totalItems *int) string {
	if totalItems == nil {
		return fmt.Sprintf("%d records", rowCount)
	}
	return fmt.Sprintf("%d of %d records", rowCount, *totalItems)
}

templ dataTable(rows [][]dataTableCell, columns []dataTableColumn, rowHrefs []string, emptyMessage, path string, query Query, totalItems *int, filter templ.Component, filterModalID string) {
	<div class="table-responsive">
		<table class="data-table table table-hover table-striped table-vcenter">
			<thead>
				if path != "" {
					@dataTableHeader(len(rows), len(columns), path, query, totalItems, filter != nil, filterModalID)
				}
				@dataTableColumns(columns, path, query)
			</thead>
			<tbody>
				for rowIndex, row := range rows {
					if rowHrefs[rowIndex] != "" {
						<tr data-swr={ rowHrefs[rowIndex] }>
							@cells(row, columns)
						</tr>
					} else {
						<tr>
							@cells(row, columns)
						</tr>
					}
				}
				if len(rows) == 0 {
					<tr>
						<td
							class="text-center text-secondary"
							colspan={ fmt.Sprint(len(columns)) }
						>
							if emptyMessage == "" {
								No data available
							} else {
								{ emptyMessage }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if filter != nil {
		<div
			id={ filterModalID }
			aria-hidden="true"
			aria-labelledby={ filterModalID + "-title" }
			class="fade modal modal-blur"
			tabindex="-1"
		>
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					@filter
				</div>
			</div>
		</div>
	}
	@paginationNav(path, query, totalItems)
}

templ dataTableColumns(columns []dataTableColumn, path string, query Query) {
	<tr>
		for _, column := range columns {
			<th>
				if column.Sortable && path != "" {
					<a
						class="text-decoration-none text-reset"
						data-swr="true"
						href={ queryHref(path, sortQuery(query, column.Field), 1) }
					>
						{ column.Header }
						if query.Sort == column.Field && query.Direction == "asc" {
							<i
								aria-label="Sorted ascending"
								class="text-primary ti ti-arrow-up"
							></i>
						} else if query.Sort == column.Field && query.Direction == "desc" {
							<i
								aria-label="Sorted descending"
								class="text-primary ti ti-arrow-down"
							></i>
						} else {
							<i
								aria-label="Not sorted"
								class="text-secondary ti ti-arrows-sort"
							></i>
						}
					</a>
				} else {
					{ column.Header }
				}
			</th>
		}
	</tr>
}

templ dataTableHeader(rowCount, columnCount int, path string, query Query, totalItems *int, hasFilter bool, filterModalID string) {
	{{ filterSummary := filterSummary(query.Filters) }}
	<tr>
		<th colspan={ fmt.Sprint(columnCount) }>
			<div class="align-items-center g-2 row">
				<div class="col-md-4">
					if hasFilter {
						<button
							aria-label="Filter"
							class="btn btn-icon btn-primary rounded-circle"
							data-filter-modal
							data-bs-target={ "#" + filterModalID }
							data-bs-toggle="modal"
							type="button"
						>
							<i aria-hidden="true" class="ti ti-filter"></i>
						</button>
					}
				</div>
				<div class="col-md-4 text-center">
					<div
						aria-label={ recordsLabel(rowCount, totalItems) }
						class="small"
					>
						Records: { fmt.Sprint(rowCount) }
						if totalItems != nil {
							{ " / " }
							{ fmt.Sprint(*totalItems) }
						}
					</div>
					if filterSummary != "" {
						<div class="small text-secondary">
							<small class="font-monospace">
								{ filterSummary }
							</small>
						</div>
					}
				</div>
				<div class="col-md-4 d-flex justify-content-md-end">
					<form
						action={ queryHref(path, query, query.Page) }
						data-swr-navigate
						method="get"
					>
						<div class="input-icon">
							<span class="input-icon-addon">
								<i aria-hidden="true" class="ti ti-search"></i>
							</span>
							<input
								aria-label="Search"
								class="form-control w-auto"
								name="search"
								placeholder="Search"
								type="search"
								value={ query.Search }
							/>
						</div>
					</form>
				</div>
			</div>
		</th>
	</tr>
}

templ paginationNav(path string, query Query, totalItems *int) {
	{{
		if path == "" || totalItems == nil {
			return
		}
	}}
	{{ totalPages := max(1, (*totalItems+query.Size-1)/query.Size) }}
	<div class="align-items-center card-footer d-flex flex-column flex-md-row gap-2 justify-content-center">
		if totalPages > 1 {
			<nav aria-label="Pagination">
				<ul class="justify-content-center mb-0 pagination">
					@paginationControl(path, query, 1, "ti-chevrons-left", "First page", query.Page > 1)
					@paginationControl(path, query, query.Page-1, "ti-chevron-left", "Previous page", query.Page > 1)
					for _, pageNumber := range paginationPages(query.Page, totalPages) {
						@paginationPage(path, query, pageNumber)
					}
					@paginationControl(path, query, query.Page+1, "ti-chevron-right", "Next page", query.Page < totalPages)
					@paginationControl(path, query, totalPages, "ti-chevrons-right", "Last page", query.Page < totalPages)
				</ul>
			</nav>
		}
		<select
			aria-label="Page size"
			class="form-select ms-md-3 w-auto"
			data-swr-navigate
			name="size"
		>
			for _, size := range Sizes {
				<option
					selected?={ query.Size == size }
					value={ strconv.Itoa(size) }
				>{ strconv.Itoa(size) }</option>
			}
		</select>
	</div>
}

func paginationPages(page, totalPages int) []int {
	if totalPages <= 5 {
		pages := make([]int, totalPages)
		for index := range pages {
			pages[index] = index + 1
		}
		return pages
	}
	start := max(1, min(page-2, totalPages-4))
	pages := make([]int, 5)
	for index := range pages {
		pages[index] = start + index
	}
	return pages
}

templ paginationControl(path string, query Query, page int, icon, label string, enabled bool) {
	if enabled {
		<li class="page-item">
			<a
				aria-label={ label }
				class="page-link"
				data-swr="true"
				href={ queryHref(path, query, page) }
			>
				<i aria-hidden="true" class={ "ti", icon }></i>
			</a>
		</li>
	} else {
		<li class="disabled page-item">
			<span aria-disabled="true" class="page-link">
				<i aria-hidden="true" class={ "ti", icon }></i>
			</span>
		</li>
	}
}

templ paginationPage(path string, query Query, page int) {
	if page == query.Page {
		<li class="active page-item">
			<a
				aria-current="page"
				class="page-link"
				href={ queryHref(path, query, page) }
			>
				{ strconv.Itoa(page) }
			</a>
		</li>
	} else {
		<li class="page-item">
			<a
				aria-label={ "Page " + strconv.Itoa(page) }
				class="page-link"
				data-swr="true"
				href={ queryHref(path, query, page) }
			>
				{ strconv.Itoa(page) }
			</a>
		</li>
	}
}

templ cells(row []dataTableCell, columns []dataTableColumn) {
	for index := range columns {
		<td class={ row[index].Class }>
			if row[index].Component != nil {
				@row[index].Component
			} else {
				{ row[index].Text }
			}
		</td>
	}
}
