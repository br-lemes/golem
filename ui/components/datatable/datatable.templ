package datatable

import (
	"fmt"
	"net/url"
	"strconv"
)

type Column[T any] struct {
	Cell     func(T) templ.Component
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type DataTableProps[T any] struct {
	Columns       []Column[T]
	Data          []T
	EmptyMessage  string
	Filter        templ.Component
	FilterModalID string
	Refresh       string
	RefreshPeriod int
	Path          string
	Query         Query
	TotalItems    *int
	RowHref       func(T) string
	Diff          bool
	RowKey        func(T) string
}

const (
	RefreshManual = "manual"
	RefreshAuto   = "auto"
)

type Query struct {
	Page      int
	Size      int
	Search    string
	Sort      string
	Direction string
	Filters   map[string]string
}

type dataTableColumn struct {
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type dataTableCell struct {
	Class     string
	Component templ.Component
	Text      string
}

type dataTableRow struct {
	Cells []dataTableCell
	Href  string
	Key   string
}

type dataTableState struct {
	Columns       []dataTableColumn
	Diff          bool
	EmptyMessage  string
	Filter        templ.Component
	FilterModalID string
	Path          string
	Query         Query
	Refresh       string
	RefreshPeriod int
	Rows          []dataTableRow
	TotalItems    *int
}

func DataTable[T any](props DataTableProps[T]) templ.Component {
	if props.Query.Size == 0 {
		props.Query.Size = DefaultSize
	}
	return dataTable(dataTableState{
		Columns:       buildColumns(props.Columns),
		Diff:          props.Diff,
		EmptyMessage:  props.EmptyMessage,
		Filter:        props.Filter,
		FilterModalID: props.FilterModalID,
		Path:          props.Path,
		Query:         props.Query,
		Refresh:       props.Refresh,
		RefreshPeriod: props.RefreshPeriod,
		Rows:          buildRows(props),
		TotalItems:    props.TotalItems,
	})
}

templ Styles() {
	<style>
		.data-table {
			--tblr-table-striped-bg: color-mix(
				in oklab,
				var(--tblr-body-color) 3%,
				transparent
			);
			font-size: 1rem;
			line-height: 1.5;
		}

		.data-table > :not(caption) > * > * {
			padding: 0.5rem;
		}

		.data-table > thead > tr > th {
			background: var(--tblr-table-striped-bg);
			color: inherit;
			font-size: inherit;
			font-weight: bold;
			letter-spacing: normal;
			line-height: inherit;
			text-transform: none;
			white-space: normal;
		}
	</style>
}

func queryHref(path string, query Query, page int) string {
	values := url.Values{}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	if query.Size != 0 && query.Size != DefaultSize {
		values.Set("size", strconv.Itoa(query.Size))
	}
	if query.Search != "" {
		values.Set("search", query.Search)
	}
	if query.Sort != "" && (query.Direction == "asc" || query.Direction == "desc") {
		values.Set("sort", query.Sort)
		values.Set("direction", query.Direction)
	}
	for key, value := range query.Filters {
		if value != "" {
			values.Set("filter["+key+"]", value)
		}
	}
	encoded := values.Encode()
	if encoded != "" {
		return path + "?" + encoded
	}
	return path
}

templ dataTable(state dataTableState) {
	if state.Path != "" {
		@dataTableHeader(state)
	}
	<div class="table-responsive">
		<table
			class="data-table table table-hover table-striped table-vcenter"
			data-swr-diff?={ state.Diff }
		>
			<thead>
				@dataTableColumns(state)
			</thead>
			<tbody>
				for _, row := range state.Rows {
					if row.Href != "" {
						<tr
							data-swr={ row.Href }
							data-swr-key={ row.Key }
						>
							@cells(row.Cells, state.Columns)
						</tr>
					} else {
						<tr data-swr-key={ row.Key }>
							@cells(row.Cells, state.Columns)
						</tr>
					}
				}
				if len(state.Rows) == 0 {
					<tr>
						<td
							class="text-center text-secondary"
							colspan={ fmt.Sprint(len(state.Columns)) }
						>
							if state.EmptyMessage == "" {
								No data available
							} else {
								{ state.EmptyMessage }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if state.Filter != nil {
		<div
			id={ state.FilterModalID }
			aria-hidden="true"
			aria-labelledby={ state.FilterModalID + "-title" }
			class="fade modal modal-blur"
			tabindex="-1"
		>
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					@state.Filter
				</div>
			</div>
		</div>
	}
	@paginationNav(state)
}

templ cells(row []dataTableCell, columns []dataTableColumn) {
	for index := range columns {
		<td
			class={ row[index].Class }
			data-swr-field={ columns[index].Field }
		>
			if row[index].Component != nil {
				@row[index].Component
			} else {
				{ row[index].Text }
			}
		</td>
	}
}
