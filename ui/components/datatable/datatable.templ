package datatable

import (
	"cmp"
	"fmt"
	"net/url"
	"reflect"
	"sort"
	"strconv"
	"strings"
)

type Column[T any] struct {
	Cell     func(T) templ.Component
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type DataTableProps[T any] struct {
	Columns       []Column[T]
	Data          []T
	EmptyMessage  string
	Filter        templ.Component
	FilterModalID string
	Path          string
	Query         Query
	TotalItems    *int
	RowHref       func(T) string
}

type Query struct {
	Page      int
	Size      int
	Search    string
	Sort      string
	Direction string
	Filters   map[string]string
}

type dataTableColumn struct {
	Class    string
	Field    string
	Header   string
	Sortable bool
}

type dataTableCell struct {
	Class     string
	Component templ.Component
	Text      string
}

func DataTable[T any](props DataTableProps[T]) templ.Component {
	if props.Query.Size == 0 {
		props.Query.Size = DefaultSize
	}
	value := reflect.ValueOf(props.Data)

	rows := make([][]dataTableCell, value.Len())
	rowHrefs := make([]string, value.Len())
	for rowIndex := 0; rowIndex < value.Len(); rowIndex++ {
		item := value.Index(rowIndex)
		rows[rowIndex] = make([]dataTableCell, len(props.Columns))
		for columnIndex, column := range props.Columns {
			cell := dataTableCell{Class: column.Class}
			if column.Cell != nil {
				cell.Component = column.Cell(item.Interface().(T))
			} else if column.Field != "" {
				cell.Text = tableFieldText(item, column.Field)
			}
			rows[rowIndex][columnIndex] = cell
		}
		if props.RowHref != nil {
			rowHrefs[rowIndex] = props.RowHref(item.Interface().(T))
		}
	}

	definitions := make([]dataTableColumn, len(props.Columns))
	for index, column := range props.Columns {
		definitions[index] = dataTableColumn{
			Header:   column.Header,
			Class:    column.Class,
			Field:    column.Field,
			Sortable: column.Sortable,
		}
	}
	return dataTable(rows, definitions, rowHrefs, props.EmptyMessage, props.Path, props.Query, props.TotalItems, props.Filter, props.FilterModalID)
}

func Sort[T any](items []T, field, direction string, columns []Column[T]) {
	if direction != "asc" && direction != "desc" {
		return
	}
	for _, column := range columns {
		if column.Field != field || !column.Sortable {
			continue
		}
		sort.SliceStable(items, func(left, right int) bool {
			comparison := compareFields(reflect.ValueOf(items[left]), reflect.ValueOf(items[right]), field)
			if direction == "asc" {
				return comparison < 0
			}
			return comparison > 0
		})
		return
	}
}

func compareFields(left, right reflect.Value, fieldName string) int {
	left = fieldValue(left, fieldName)
	right = fieldValue(right, fieldName)
	if !left.IsValid() || !right.IsValid() {
		return 0
	}
	switch left.Kind() {
	case reflect.String:
		return strings.Compare(left.String(), right.String())
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		return cmp.Compare(left.Int(), right.Int())
	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
		return cmp.Compare(left.Uint(), right.Uint())
	case reflect.Float32, reflect.Float64:
		return cmp.Compare(left.Float(), right.Float())
	default:
		return 0
	}
}

func fieldValue(value reflect.Value, fieldName string) reflect.Value {
	for value.IsValid() && value.Kind() == reflect.Pointer {
		if value.IsNil() {
			return reflect.Value{}
		}
		value = value.Elem()
	}
	if !value.IsValid() || value.Kind() != reflect.Struct {
		return reflect.Value{}
	}
	typeOfValue := value.Type()
	for index := 0; index < value.NumField(); index++ {
		field := typeOfValue.Field(index)
		if strings.Split(field.Tag.Get("json"), ",")[0] == fieldName {
			return value.Field(index)
		}
	}
	return reflect.Value{}
}

templ Styles() {
	<style>
		.data-table {
			--tblr-table-striped-bg: color-mix(
				in oklab,
				var(--tblr-body-color) 3%,
				transparent
			);
			font-size: 1rem;
			line-height: 1.5;
		}

		.data-table > :not(caption) > * > * {
			padding: 0.5rem;
		}

		.data-table > thead > tr > th {
			background: var(--tblr-table-striped-bg);
			color: inherit;
			font-size: inherit;
			font-weight: bold;
			letter-spacing: normal;
			line-height: inherit;
			text-transform: none;
			white-space: normal;
		}
	</style>
}

func tableFieldText(item reflect.Value, fieldName string) string {
	for item.Kind() == reflect.Pointer {
		if item.IsNil() {
			return ""
		}
		item = item.Elem()
	}
	if item.Kind() != reflect.Struct {
		panic("data table items must contain structs")
	}

	typeOfItem := item.Type()
	for index := 0; index < item.NumField(); index++ {
		field := typeOfItem.Field(index)
		jsonName := strings.Split(field.Tag.Get("json"), ",")[0]
		if jsonName == fieldName {
			return fmt.Sprint(item.Field(index).Interface())
		}
	}
	panic(fmt.Sprintf("data table field %q not found in %s", fieldName, typeOfItem))
}

func queryHref(path string, query Query, page int) string {
	values := url.Values{}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	if query.Size != 0 && query.Size != DefaultSize {
		values.Set("size", strconv.Itoa(query.Size))
	}
	if query.Search != "" {
		values.Set("search", query.Search)
	}
	if query.Sort != "" && (query.Direction == "asc" || query.Direction == "desc") {
		values.Set("sort", query.Sort)
		values.Set("direction", query.Direction)
	}
	for key, value := range query.Filters {
		if value != "" {
			values.Set("filter["+key+"]", value)
		}
	}
	encoded := values.Encode()
	if encoded != "" {
		return path + "?" + encoded
	}
	return path
}

templ dataTable(rows [][]dataTableCell, columns []dataTableColumn, rowHrefs []string, emptyMessage, path string, query Query, totalItems *int, filter templ.Component, filterModalID string) {
	<div class="table-responsive">
		<table class="data-table table table-hover table-striped table-vcenter">
			<thead>
				if path != "" {
					@dataTableHeader(len(rows), len(columns), path, query, totalItems, filter != nil, filterModalID)
				}
				@dataTableColumns(columns, path, query)
			</thead>
			<tbody>
				for rowIndex, row := range rows {
					if rowHrefs[rowIndex] != "" {
						<tr data-swr={ rowHrefs[rowIndex] }>
							@cells(row, columns)
						</tr>
					} else {
						<tr>
							@cells(row, columns)
						</tr>
					}
				}
				if len(rows) == 0 {
					<tr>
						<td
							class="text-center text-secondary"
							colspan={ fmt.Sprint(len(columns)) }
						>
							if emptyMessage == "" {
								No data available
							} else {
								{ emptyMessage }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if filter != nil {
		<div
			id={ filterModalID }
			aria-hidden="true"
			aria-labelledby={ filterModalID + "-title" }
			class="fade modal modal-blur"
			tabindex="-1"
		>
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					@filter
				</div>
			</div>
		</div>
	}
	@paginationNav(path, query, totalItems)
}

templ cells(row []dataTableCell, columns []dataTableColumn) {
	for index := range columns {
		<td class={ row[index].Class }>
			if row[index].Component != nil {
				@row[index].Component
			} else {
				{ row[index].Text }
			}
		</td>
	}
}
