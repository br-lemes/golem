package loading

templ Bar() {
	<div
		aria-hidden="true"
		class="bg-transparent position-sticky progress progress-sm shadow-none z-3"
		style="top: 3.5rem;"
	>
		<div
			id="swr-loading-bar"
			class="d-none progress-bar progress-bar-indeterminate"
		></div>
	</div>
}

templ Overlay() {
	<div
		id="swr-loading-overlay"
		aria-hidden="true"
		class="bg-body bg-opacity-75 bottom-0 d-none end-0 position-absolute start-0 top-0 z-3"
	></div>
}
