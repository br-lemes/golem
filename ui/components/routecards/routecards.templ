package routecards

import "github.com/br-lemes/golem/ui/routes"

type Props = routes.Route

templ RouteCards(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class="d-flex flex-wrap gap-4 justify-content-center">
		for _, child := range p.Route.Children {
			if child.Handler != nil {
				<a
					class="btn btn-outline-secondary d-flex flex-column gap-2"
					data-swr="true"
					href={ child.Path }
					style="height: 6rem; width: 10rem;"
				>
					if child.Segment.Icon != "" {
						<i
							aria-hidden="true"
							class={ "fs-1 ti", child.Segment.Icon }
						></i>
					}
					<span class="fs-3 fw-semibold">
						{ child.Segment.Label }
					</span>
				</a>
			}
		}
	</div>
}
