package themeswitcher

type Props struct {
	Class string
}

templ ThemeSwitcher(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class={ "dropdown", p.Class }>
		<button
			aria-expanded="false"
			aria-label="Color mode"
			class="align-items-center btn btn-ghost-secondary d-flex dropdown-toggle"
			data-bs-toggle="dropdown"
			type="button"
		>
			<i
				aria-hidden="true"
				class="d-none ti ti-sun"
				data-golem-theme-icon="light"
			></i>
			<i
				aria-hidden="true"
				class="d-none ti ti-moon"
				data-golem-theme-icon="dark"
			></i>
			<i
				aria-hidden="true"
				class="ti ti-circle-half-2"
				data-golem-theme-icon="auto"
			></i>
		</button>
		<div class="dropdown-menu dropdown-menu-end">
			<button class="dropdown-item" data-golem-theme="light" type="button">
				<i aria-hidden="true" class="ti ti-sun me-2"></i>
				Light
			</button>
			<button class="dropdown-item" data-golem-theme="dark" type="button">
				<i aria-hidden="true" class="ti ti-moon me-2"></i>
				Dark
			</button>
			<button class="dropdown-item" data-golem-theme="auto" type="button">
				<i aria-hidden="true" class="ti ti-circle-half-2 me-2"></i>
				Auto
			</button>
		</div>
	</div>
}
