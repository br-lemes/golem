package navigation

import (
	"fmt"
	"strings"

	"github.com/br-lemes/golem/ui/components/themeswitcher"
	"github.com/br-lemes/golem/ui/routes"
)

type Props struct {
	Groups bool
	Path   string
}

var appVersion string

func SetVersion(version string) {
	appVersion = version
}

templ Styles() {
	<style>
		#sidebar:not(.navbar-folded) .navigation-item {
			padding-inline-start: var(--navigation-indent);
		}
		@media (min-width: 992px) {
			#sidebar {
				--tblr-navbar-border-width: 0;
			}
			.page-wrapper {
				border-inline-start: var(--tblr-border-width)
					var(--tblr-border-style) var(--tblr-border-color);
			}
		}
	</style>
}

templ Navigation(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<aside
		id="sidebar"
		aria-label="Primary navigation"
		class="navbar navbar-expand-lg navbar-vertical sticky-top"
	>
		<div class="container-fluid">
			<button
				aria-controls="sidebar-menu"
				aria-expanded="false"
				aria-label="Toggle navigation"
				class="navbar-toggler"
				data-bs-target="#sidebar-menu"
				data-bs-toggle="collapse"
				type="button"
			>
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="d-lg-none navbar-brand">
				@brand()
			</div>
			<div class="d-lg-none flex-row navbar-nav">
				@themeswitcher.ThemeSwitcher()
			</div>
			<nav id="sidebar-menu" class="collapse navbar-collapse">
				<ul class="navbar-nav">
					@version()
					@items(routes.Navigation(), p.Path, p.Groups)
				</ul>
			</nav>
		</div>
	</aside>
	@header()
}

templ header() {
	<header class="d-lg-flex d-none navbar sticky-top">
		<div class="container-fluid d-flex position-relative">
			<button
				aria-controls="sidebar"
				aria-expanded="false"
				aria-label="Fold sidebar"
				aria-pressed="false"
				class="navbar-toggler"
				data-sidebar-fold
				type="button"
			>
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="position-absolute start-50 top-50 translate-middle">
				<div class="navbar-brand m-0">
					@brand()
				</div>
			</div>
			<div class="flex-row ms-auto navbar-nav">
				@themeswitcher.ThemeSwitcher()
			</div>
		</div>
	</header>
}

templ brand() {
	<a
		aria-label="Golem"
		class="align-items-center d-flex gap-2 text-decoration-none text-reset"
		data-swr="true"
		href="/"
		style="font-variant-caps: small-caps;"
	>
		<img
			alt="Golem"
			class="navbar-brand-image"
			src="/assets/images/head.png"
		/>
		Golem
	</a>
}

templ version() {
	{{ development := appVersion != "" && !strings.HasPrefix(appVersion, "v") }}
	<li class="nav-item">
		<span
			class="justify-content-center nav-link pe-none"
			style="min-height: 3.5rem;"
		>
			<span class="nav-link-title">
				<span class={ "badge", templ.KV("bg-danger-lt", development) }>
					{ appVersion }
				</span>
			</span>
		</span>
	</li>
}

templ items(nodes []*routes.Node, currentPath string, groups bool) {
	for _, node := range nodes {
		if node.Segment.Label != "" {
			if groups && hasVisibleChildren(node) {
				@itemGroup(node, currentPath)
			} else {
				@item(node, currentPath)
			}
		}
	}
}

templ itemGroup(node *routes.Node, currentPath string) {
	<li class="nav-section-title">{ node.Segment.Label }</li>
	@items(node.Children, currentPath, false)
}

templ item(node *routes.Node, currentPath string) {
	if hasVisibleChildren(node) {
		@itemWithChildren(node, currentPath)
	} else if node.Handler != nil {
		@itemLink(node, currentPath)
	}
}

templ itemWithChildren(node *routes.Node, currentPath string) {
	{{ open := isPathActive(node, currentPath) }}
	<li class={ "dropdown nav-item", templ.KV("active", open) }>
		<a
			aria-expanded={ fmt.Sprintf("%t", open) }
			class="dropdown-toggle nav-link"
			data-bs-auto-close="false"
			data-bs-toggle="dropdown"
			data-swr-href={ node.Path }
			href="#"
			role="button"
		>
			if node.Segment.Icon != "" {
				<span class="align-items-center d-flex justify-content-center nav-link-icon">
					<i
						aria-hidden="true"
						class={ "fs-1 ti", node.Segment.Icon }
					></i>
				</span>
			}
			<span class="nav-link-title">{ node.Segment.Label }</span>
		</a>
		<div class={ "dropdown-menu", templ.KV("show", open) }>
			@dropdownItems(node.Children, currentPath, 1.5)
		</div>
	</li>
}

templ itemLink(node *routes.Node, currentPath string) {
	{{ active := isPathActive(node, currentPath) }}
	<li class={ "nav-item", templ.KV("active", active) }>
		<a
			class={ "nav-link", templ.KV("active", active) }
			data-swr="true"
			href={ node.Path }
		>
			if node.Segment.Icon != "" {
				<span class="align-items-center d-flex justify-content-center nav-link-icon">
					<i
						aria-hidden="true"
						class={ "fs-1 ti", node.Segment.Icon }
					></i>
				</span>
			}
			<span class="nav-link-title">{ node.Segment.Label }</span>
		</a>
	</li>
}

templ dropdownItems(nodes []*routes.Node, currentPath string, indent float64) {
	for _, node := range nodes {
		if node.Segment.Label != "" {
			@dropdownItem(node, currentPath, indent)
		}
	}
}

templ dropdownItem(node *routes.Node, currentPath string, indent float64) {
	if hasVisibleChildren(node) {
		@dropdownItemWithChildren(node, currentPath, indent)
	} else if node.Handler != nil {
		@dropdownItemLink(node, currentPath, indent)
	}
}

templ dropdownItemWithChildren(node *routes.Node, currentPath string, indent float64) {
	{{ open := isPathActive(node, currentPath) }}
	<div class="dropend">
		<a
			aria-expanded={ fmt.Sprintf("%t", open) }
			class="dropdown-item dropdown-toggle navigation-item"
			data-bs-auto-close="false"
			data-bs-toggle="dropdown"
			data-swr-href={ node.Path }
			href="#"
			role="button"
			style={ itemStyle(indent) }
		>
			if node.Segment.Icon != "" {
				<i
					aria-hidden="true"
					class={ "align-items-center d-flex dropdown-item-icon justify-content-center ti", node.Segment.Icon }
				></i>
			}
			<span class="flex-grow-1 text-truncate">
				{ node.Segment.Label }
			</span>
		</a>
		<div class={ "dropdown-menu", templ.KV("show", open) }>
			@dropdownItems(node.Children, currentPath, indent+0.5)
		</div>
	</div>
}

templ dropdownItemLink(node *routes.Node, currentPath string, indent float64) {
	<a
		class={ "dropdown-item navigation-item", templ.KV("active", isPathActive(node, currentPath)) }
		data-swr="true"
		href={ node.Path }
		style={ itemStyle(indent) }
	>
		if node.Segment.Icon != "" {
			<i
				aria-hidden="true"
				class={ "align-items-center d-flex dropdown-item-icon justify-content-center ti", node.Segment.Icon }
			></i>
		}
		<span class="flex-grow-1 text-truncate">
			{ node.Segment.Label }
		</span>
	</a>
}

func hasVisibleChildren(node *routes.Node) bool {
	for _, child := range node.Children {
		if child.Segment.Label != "" {
			return true
		}
	}
	return false
}

func isPathActive(node *routes.Node, currentPath string) bool {
	return node.Path != "" && (currentPath == node.Path || strings.HasPrefix(currentPath, node.Path+"/"))
}

func itemStyle(indent float64) string {
	// cSpell: disable-next-line
	return fmt.Sprintf("--navigation-indent: %grem", indent)
}
