package routetrail

import "github.com/br-lemes/golem/ui/routes"

type Props = routes.Route

templ RouteTrail(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		trail := routes.Trail(p.Route)
		if len(trail) <= 0 {
			return
		}
		name := trail[len(trail)-1].Segment.Label
		if p.Label != "" {
			name = p.Label
		}
	}}
	<h1 class="display-6 fw-bold">{ name }</h1>
	<nav aria-label="Breadcrumb" class="mb-5">
		<ol class="breadcrumb breadcrumb-arrows breadcrumb-muted fs-3 mb-0">
			<li class="breadcrumb-item">
				<a
					aria-label="Home"
					class="text-decoration-none"
					data-swr="true"
					href="/"
				>
					<i aria-hidden="true" class="ti ti-home"></i>
				</a>
			</li>
			for i, item := range trail {
				if i == len(trail)-1 {
					<li aria-current="page" class="breadcrumb-item active">
						{ name }
					</li>
				} else {
					<li class="breadcrumb-item">
						<a
							class="text-decoration-none"
							data-swr="true"
							href={ item.Path }
						>
							{ item.Segment.Label }
						</a>
					</li>
				}
			}
		</ol>
	</nav>
}
