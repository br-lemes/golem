package catalog

import (
	"net/http"

	"github.com/br-lemes/golem/ui/components/routecards"
	"github.com/br-lemes/golem/ui/layouts"
	_ "github.com/br-lemes/golem/ui/pages/catalog/effects"
	_ "github.com/br-lemes/golem/ui/pages/catalog/events"
	_ "github.com/br-lemes/golem/ui/pages/catalog/items"
	_ "github.com/br-lemes/golem/ui/pages/catalog/monsters"
	_ "github.com/br-lemes/golem/ui/pages/catalog/resources"
	"github.com/br-lemes/golem/ui/routes"
	"github.com/br-lemes/golem/ui/shadcn/icon"
)

var route *routes.Node

func init() {
	route = routes.RegisterRoute(routes.Definition{
		Label: "Catalog",
		Path:  "/catalog",
		Icon:  icon.Boxes(icon.Props{Class: "shrink-0 size-4"}),
		Handler: func(_ *http.Request) (templ.Component, int) {
			return Catalog(), http.StatusOK
		},
	})
}

templ Catalog() {
	@layouts.Base(layouts.Props{Route: route}) {
		@routecards.RouteCards(routecards.Props{Route: route})
	}
}
