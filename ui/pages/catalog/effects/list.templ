package effects

import (
	"net/http"

	"github.com/br-lemes/golem/pkg/catalog"
	"github.com/br-lemes/golem/pkg/schemas"
	"github.com/br-lemes/golem/ui/components/artifact"
	"github.com/br-lemes/golem/ui/components/datatable"
	"github.com/br-lemes/golem/ui/layouts"
	"github.com/br-lemes/golem/ui/routes"
)

var route *routes.Node

var columns = []datatable.Column[*schemas.EffectSchema]{
	{Header: "Code", Field: "code", Sortable: true, Cell: cell},
	{Header: "Type", Field: "type", Sortable: true},
	{Header: "Subtype", Field: "subtype", Sortable: true},
	{Header: "Description", Field: "description", Cell: description},
}

func init() {
	route = routes.RegisterRoute(routes.Definition{
		Label: "Effects",
		Path:  "/catalog/effects",
		Icon:  "ti-sparkles",
		Handler: func(request *http.Request) (templ.Component, int) {
			query := datatable.QueryFromRequest(request)
			effects := catalog.Effects().All()
			effects = datatable.Search(effects, query.Search, columns)
			page := datatable.Prepare(effects, query, columns)
			query.Page = page.Page
			return List(page, query), http.StatusOK
		},
	})
}

templ List(page datatable.Page[*schemas.EffectSchema], query datatable.Query) {
	@layouts.Base(layouts.Props{Route: route}) {
		<div class="card">
			@datatable.DataTable(datatable.DataTableProps[*schemas.EffectSchema]{
				Columns:    columns,
				Data:       page.Data,
				Path:       route.Path,
				Query:      query,
				TotalItems: &page.TotalItems,
			})
		</div>
	}
}

templ cell(effect *schemas.EffectSchema) {
	@artifact.Label(artifact.Props{
		Class: "font-monospace small",
		Code:  effect.Code,
		Name:  effect.Name,
		Type:  artifact.TypeEffects,
	})
}

templ description(effect *schemas.EffectSchema) {
	<div class="d-grid">
		<span class="text-truncate" title={ effect.Description }>
			{ effect.Description }
		</span>
	</div>
}
