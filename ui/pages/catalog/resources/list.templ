package resources

import (
	"net/http"

	"github.com/br-lemes/golem/pkg/catalog"
	"github.com/br-lemes/golem/pkg/schemas"
	"github.com/br-lemes/golem/ui/components/artifact"
	"github.com/br-lemes/golem/ui/components/datatable"
	"github.com/br-lemes/golem/ui/layouts"
	"github.com/br-lemes/golem/ui/routes"
)

var route *routes.Node

var columns = []datatable.Column[*schemas.ResourceSchema]{
	{Header: "Code", Field: "code", Sortable: true, Cell: cell},
	{Header: "Skill", Field: "skill", Sortable: true},
	{Header: "Level", Field: "level", Sortable: true},
}

func init() {
	route = routes.RegisterRoute(routes.Definition{
		Label: "Resources",
		Path:  "/catalog/resources",
		Icon:  "ti-leaf",
		Handler: func(request *http.Request) (templ.Component, int) {
			query := datatable.QueryFromRequest(request)
			resources := catalog.Resources.All()
			resources = datatable.Search(resources, query.Search, columns)
			page := datatable.Prepare(resources, query, columns)
			query.Page = page.Page
			return List(page, query), http.StatusOK
		},
	})
}

templ List(page datatable.Page[*schemas.ResourceSchema], query datatable.Query) {
	@layouts.Base(layouts.Props{Route: route}) {
		<div class="card">
			@datatable.DataTable(datatable.DataTableProps[*schemas.ResourceSchema]{
				Columns:    columns,
				Data:       page.Data,
				Path:       route.Path,
				Query:      query,
				TotalItems: &page.TotalItems,
				RowHref: func(resource *schemas.ResourceSchema) string {
					return route.Path + "/" + resource.Code
				},
			})
		</div>
	}
}

templ cell(resource *schemas.ResourceSchema) {
	@artifact.Label(artifact.Props{
		Class: "font-monospace small",
		Code:  resource.Code,
		Name:  resource.Name,
		Type:  artifact.TypeResources,
	})
}
