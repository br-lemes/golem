package resources

import (
	"net/http"

	"github.com/br-lemes/golem/pkg/catalog"
	"github.com/br-lemes/golem/pkg/schemas"
	"github.com/br-lemes/golem/ui/components/artifact"
	"github.com/br-lemes/golem/ui/components/datatable"
	"github.com/br-lemes/golem/ui/layouts"
	"github.com/br-lemes/golem/ui/routes"
	"github.com/br-lemes/golem/ui/shadcn/icon"
)

var route *routes.Node

func init() {
	route = routes.RegisterRoute(routes.Definition{
		Label: "Resources",
		Path:  "/catalog/resources",
		Icon:  icon.Package(icon.Props{Class: "shrink-0 size-4"}),
		Handler: func(_ *http.Request) (templ.Component, int) {
			return List(catalog.Resources.All()), http.StatusOK
		},
	})
}

templ List(resources []*schemas.ResourceSchema) {
	@layouts.Base(layouts.Props{Route: route}) {
		@datatable.DataTable(datatable.DataTableProps[*schemas.ResourceSchema]{
			Data: resources,
			Columns: []datatable.Column[*schemas.ResourceSchema]{
				{Header: "Code", Field: "code", Cell: cell},
				{Header: "Name", Field: "name"},
				{Header: "Skill", Field: "skill", Class: "font-mono"},
				{Header: "Level", Field: "level"},
			},
			RowHref: func(resource *schemas.ResourceSchema) string {
				return route.Path + "/" + resource.Code
			},
		})
	}
}

templ cell(resource *schemas.ResourceSchema) {
	@artifact.Label(artifact.Props{
		Class: "font-mono text-xs",
		Code:  resource.Code,
		Name:  resource.Name,
		Type:  artifact.TypeResources,
	})
}
