package resources

import (
	"encoding/json"
	"net/http"

	"github.com/br-lemes/golem/pkg/catalog"
	"github.com/br-lemes/golem/pkg/schemas"
	"github.com/br-lemes/golem/ui/components/artifact"
	"github.com/br-lemes/golem/ui/components/datatable"
	"github.com/br-lemes/golem/ui/components/error404"
	"github.com/br-lemes/golem/ui/layouts"
	"github.com/br-lemes/golem/ui/routes"
)

var view *routes.Node

func init() {
	view = routes.RegisterRoute(routes.Definition{
		Path: "/catalog/resources/{code}",
		Handler: func(request *http.Request) (templ.Component, int) {
			resource, found := catalog.Resources.Get(request.PathValue("code"))
			if !found {
				return error404.Error404(), http.StatusNotFound
			}
			return View(resource), http.StatusOK
		},
	})
}

templ View(resource *schemas.ResourceSchema) {
	@layouts.Base(layouts.Props{Route: view, Label: resource.Name}) {
		<div class="card">
			<div class="card-header">
				<ul
					class="card-header-tabs nav nav-tabs"
					data-bs-toggle="tabs"
					role="tablist"
				>
					<li class="nav-item" role="presentation">
						<a
							aria-selected="true"
							class="active nav-link"
							data-bs-toggle="tab"
							href="#resource-overview"
							role="tab"
						>
							Overview
						</a>
					</li>
					<li class="nav-item" role="presentation">
						<a
							class="nav-link"
							data-bs-toggle="tab"
							href="#resource-source"
							role="tab"
						>
							Source
						</a>
					</li>
				</ul>
			</div>
			<div class="card-body">
				<div class="tab-content">
					<div
						id="resource-overview"
						class="active show tab-pane"
						role="tabpanel"
					>
						@Overview(resource)
					</div>
					<div id="resource-source" class="tab-pane" role="tabpanel">
						@Source(resource)
					</div>
				</div>
			</div>
		</div>
		@DropsList(resource.Drops)
	}
}

templ Overview(resource *schemas.ResourceSchema) {
	<div class="align-items-center d-flex gap-4">
		@artifact.Image(artifact.Props{
			Size: "6rem",
			Code: resource.Code,
			Type: artifact.TypeResources,
			Name: resource.Name,
		})
		<div>
			<h2 class="h1 mb-1">{ resource.Code }</h2>
			<div class="ms-2">Level { resource.Level }</div>
			<div class="ms-2">{ resource.Skill }</div>
		</div>
	</div>
}

templ Source(resource *schemas.ResourceSchema) {
	{{ json, _ := json.MarshalIndent(resource, "", "  ") }}
	<pre class="mb-0">{ string(json) }</pre>
}

templ DropsList(drops []schemas.DropRateSchema) {
	<h2 class="h3 mt-5">Drops</h2>
	<div class="card">
		@datatable.DataTable(datatable.DataTableProps[schemas.DropRateSchema]{
			Data: drops,
			Columns: []datatable.Column[schemas.DropRateSchema]{
				{Header: "Code", Field: "code", Cell: dropCell},
				{Header: "Minimum", Field: "min_quantity"},
				{Header: "Maximum", Field: "max_quantity"},
				{Header: "Rate", Field: "rate"},
			},
			RowHref: func(drop schemas.DropRateSchema) string {
				return "/catalog/items/" + drop.Code
			},
		})
	</div>
}

templ dropCell(drop schemas.DropRateSchema) {
	@artifact.Label(artifact.Props{
		Class: "font-monospace small",
		Code:  drop.Code,
		Type:  artifact.TypeItems,
	})
}
